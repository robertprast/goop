# goop runtime environment.
# Copy to .env and fill in for each provider you want to enable.
# Providers with missing required keys are silently skipped at startup.

# Server
GOOP_ADDR=:8080
LOG_LEVEL=info
LOG_FORMAT=text

# Auth: single shared bearer token. Empty disables auth.
# Clients should send: Authorization: Bearer <GOOP_API_KEY>
GOOP_API_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com

# Azure OpenAI (v1 endpoint preferred)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# Anthropic
ANTHROPIC_API_KEY=

# Google Gemini (AI Studio)
GEMINI_API_KEY=

# Together AI
TOGETHER_API_KEY=

# AWS Bedrock — picks up standard AWS_* / ~/.aws creds
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
